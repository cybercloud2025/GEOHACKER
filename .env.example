# Copia este fichero a .env y rellena los valores.
# Todas las variables VITE_* acaban dentro del bundle publico: no pongas
# aqui ningun secreto de servidor (service_role, contrasenas, etc.).

# Nombre visible bajo el logotipo. Tambien se puede poner en /configuracion.
VITE_APP_NAME=

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Restringela por referente HTTP a tu dominio en Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=

# EmailJS
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_WELCOME_ID=
VITE_EMAILJS_TEMPLATE_RESET_ID=

# Muestra las cuentas de db/demo_seed.sql bajo el formulario de acceso.
# Ponlo a false en una instalacion con datos reales.
VITE_DEMO_MODE=true
